{
  "name": "rc-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:web": "vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build --emptyOutDir && electron-builder --win portable",
    "electron:build:installer": "vite build --emptyOutDir && electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.7",
    "@mdi/font": "7.4.47",
    "@serialport/parser-readline": "^12.0.0",
    "pinia": "^2.3.0",
    "serialport": "^12.0.0",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vuetify": "^3.10.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.35.0",
    "eslint-config-vuetify": "^4.2.0",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.92.1",
    "typescript": "~5.9.2",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^29.0.0",
    "unplugin-vue-router": "^0.15.0",
    "vite": "^7.1.5",
    "vite-plugin-vuetify": "^2.1.2",
    "vue-tsc": "^3.0.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.gamepad2rc.console",
    "productName": "GamePad2RC Console",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "GamePad2RC_Console_${version}.exe"
    },
    "asarUnpack": [
      "node_modules/serialport/**/*",
      "node_modules/@serialport/**/*"
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@serialport/bindings-cpp@12.0.1": true,
    "electron@31.7.7": true,
    "esbuild@0.28.1": true,
    "vue-demi@0.14.10": true
  }
}
